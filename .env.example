# Credenciais da Cloud API do WhatsApp (Meta). Este arquivo NAO vai para o git.
WHATSAPP_TOKEN=seu_token_aqui
WHATSAPP_PHONE_ID=seu_phone_id_aqui

# ID da conta WhatsApp Business (WABA), necessario para listar os templates.
# Onde achar: business.facebook.com -> WhatsApp Manager -> Configuracoes da conta -> ID da conta
WHATSAPP_WABA_ID=

API_VERSION=v19.0
SEND_INTERVAL=1.0

# --- Supabase (estado das campanhas, uploads e blocklist) ---
# Project Settings -> API. A service_role key ignora RLS: nunca exponha no navegador.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_aqui

# Teto de tempo de cada execucao de disparo, em segundos.
# Na Vercel (Hobby) o limite da plataforma e 300s: use 270 para dar margem.
# Vazio = sem teto (uso local, processo persistente).
TIME_BUDGET_S=

# --- Somente Vercel (opcional) ---
# Quando o tempo acaba, a funcao chama a si mesma para continuar o disparo. O endereco
# vem sozinho de VERCEL_URL; so preencha APP_URL se precisar apontar para outro dominio.
APP_URL=
